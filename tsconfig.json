{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "strict": true,
    "noEmit": true, "allowJs": true, "checkJs": false, "resolveJsonModule": true,
    "esModuleInterop": true, "skipLibCheck": true, "types": ["node"], "allowImportingTsExtensions": true
  },
  "include": ["ios/full/**/*.ts", "visual/**/*.ts", "e2e/helpers/**/*.ts"]
}
